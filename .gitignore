# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers skill scratch: brainstorm mockups, SDD ledgers and briefs
.superpowers/

# local verification output (screenshots + puppeteer probe scripts)
/shots/
/probe*.mjs
/shoot.mjs

# The book files themselves. These are published works: keeping them out of the
# repository is the point, and `next start` serves them from disk locally without
# them ever being committed. The manifest names every book, so it is ignored too.
/public/books/